# ============================================================================
# VALORANT PREMIER TEAM TRACKER - ENVIRONMENT CONFIGURATION (.env.example)
# ============================================================================
# Kopiere diese Datei nach `.env.local` (Entwicklung) oder setze die Variablen
# in deiner Produktionsumgebung. Speichere NIEMALS echte Schlüssel im Git-Repo
# oder im Frontend/APK-Code!

# ----------------------------------------------------------------------------
# 1. DATENBANK (PostgreSQL / Supabase)
# ----------------------------------------------------------------------------
# Verbindungs-URL für PostgreSQL oder Supabase Transaction Pooler
DATABASE_URL="postgresql://postgres:PASSWORT@db.dein-projekt.supabase.co:5432/postgres?schema=public"

# Optional: Supabase URL & Service Role Key (nur Server-seitig!)
SUPABASE_URL="https://dein-projekt.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="dein-geheimer-service-role-key"

# ----------------------------------------------------------------------------
# 2. AUTHENTIFIZIERUNG & SICHERHEIT (Backend / Admin-Bereich)
# ----------------------------------------------------------------------------
# Geheimer Schlüssel zum Signieren von Admin-/Rollen-Sessions (mind. 32 Zeichen)
AUTH_SECRET="ersetze-dies-durch-einen-zufaelligen-32-byte-hex-schluessel"

# Initiales Admin-Konto (wird beim ersten Start gehasht geprüft)
ADMIN_USERNAME="admin"
# Passwort für lokale Einrichtung (Standard in Demo/Dev: PremierAdmin2026!)
ADMIN_PASSWORD="ersetze-dieses-sichere-admin-passwort"

# Coach-Konto (Berechtigt zum Eintragen von Matches & Standings)
COACH_USERNAME="coach"
COACH_PASSWORD="ersetze-dieses-sichere-coach-passwort"

# ----------------------------------------------------------------------------
# 3. OFFIZIELLE RIOT GAMES API (Nur Server-seitig!)
# ----------------------------------------------------------------------------
# Offizieller Riot Developer Portal API Key (Production Key für VAL-MATCH-V1 erforderlich)
RIOT_API_KEY=""

# Standard-Region für ACCOUNT-V1 (europe, americas, asia, esports)
RIOT_ACCOUNT_REGION="europe"

# Standard-Shard für VAL-MATCH-V1 & VAL-CONTENT-V1 (eu, na, ap, kr, latam, br)
RIOT_VAL_SHARD="eu"

# ----------------------------------------------------------------------------
# 4. RIOT SIGN-ON (RSO) OAUTH 2.0 (Für offizielle Spielereinwilligung)
# ----------------------------------------------------------------------------
RSO_CLIENT_ID=""
RSO_CLIENT_SECRET=""
RSO_REDIRECT_URI="https://deine-domain.de/api/auth/rso/callback"

# ----------------------------------------------------------------------------
# 5. ANDROID APK / CAPACITOR KONFIGURATION
# ----------------------------------------------------------------------------
# Öffentliche Basis-URL des gemeinsamen Backends für die Android-App (ohne API-Keys!)
NEXT_PUBLIC_API_BASE_URL="http://localhost:3000"
